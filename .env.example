# Configuração opcional do servidor local; nenhum segredo é necessário para iniciar.
# npm não carrega este arquivo automaticamente. Consulte o README para exportá-lo.
DATA_DIR=.data
PORT=3001
BIND_HOST=127.0.0.1
# Use true quando a aplicação for publicada somente por HTTPS.
COOKIE_SECURE=false

# NODE_ENV=production é definido por npm start.
# O MVP usa SQLite: variáveis/chaves Supabase não são consumidas nesta versão.
